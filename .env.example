# ──────────────────────────────────────────────────────────
# PostgreSQL (Supabase)
# DATABASE_URL = Session pooler (runtime serverless trên Vercel).
# DATABASE_URL_UNPOOLED = Direct connection (migration tool nên dùng).
# ──────────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ──────────────────────────────────────────────────────────
# Supabase Storage — lưu ảnh runtime (bucket public).
# SUPABASE_URL = https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY = Project Settings → API → service_role key
# SUPABASE_STORAGE_BUCKET = tên bucket (mặc định crm-images), SUPABASE_STORAGE_PREFIX = tiền tố object (mặc định crm)
# ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-images
SUPABASE_STORAGE_PREFIX=crm

# ──────────────────────────────────────────────────────────
# Bootstrap admin (chỉ dùng khi DB trống / môi trường mới)
# ──────────────────────────────────────────────────────────
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=changeme-strong-password
CRM_ADMIN_NAME="Thế Kiệt"

# Tuỳ chọn: giới hạn connection pool (mặc định 7)
# PG_MAX_CONNECTIONS=7

# Debug chẩn đoán DB (chỉ bật tạm thời, không log giá trị params)
# SQL_DEBUG=1
# PG_STATEMENT_TIMEOUT_MS=15000